{
	"compilerOptions": {
		"target": "ES2020",
		"module": "NodeNext",
		"allowJs": true,
		"outDir": "dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": false,
		"moduleResolution": "NodeNext",
		"skipLibCheck": true,
		"resolveJsonModule": true
	},
	"include": ["src/**/*"]
}
