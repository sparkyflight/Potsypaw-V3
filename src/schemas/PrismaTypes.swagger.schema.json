{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"components": {
		"schemas": {
			"State": {
				"enum": [
					"ACTIVE",
					"BANNED",
					"VOTE_BANNED",
					"FOLLOW_BANNED",
					"PRIVATE"
				],
				"type": "string"
			},
			"applications": {
				"additionalProperties": false,
				"properties": {
					"active": {
						"type": "boolean"
					},
					"creatorid": {
						"type": "string"
					},
					"logo": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"owner": {
						"$ref": "#/components/schemas/users"
					},
					"permissions": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"token": {
						"type": "string"
					}
				},
				"required": [
					"creatorid",
					"owner",
					"name",
					"logo",
					"token",
					"active",
					"permissions"
				],
				"type": "object"
			},
			"badge": {
				"enum": ["STAFF", "VERIFIED"],
				"type": "string"
			},
			"comments": {
				"additionalProperties": false,
				"properties": {
					"caption": {
						"type": "string"
					},
					"commentid": {
						"type": "string"
					},
					"creatorid": {
						"type": "string"
					},
					"image": {
						"type": "string"
					},
					"post": {
						"$ref": "#/components/schemas/posts"
					},
					"postid": {
						"type": "string"
					},
					"user": {
						"$ref": "#/components/schemas/users"
					}
				},
				"required": [
					"creatorid",
					"user",
					"caption",
					"post",
					"postid",
					"commentid"
				],
				"type": "object"
			},
			"downvotes": {
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string"
					},
					"post": {
						"$ref": "#/components/schemas/posts"
					},
					"postid": {
						"type": "string"
					},
					"userid": {
						"type": "string"
					}
				},
				"required": ["id", "userid", "postid", "post"],
				"type": "object"
			},
			"following": {
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string"
					},
					"target": {
						"$ref": "#/components/schemas/users"
					},
					"targetid": {
						"type": "string"
					},
					"user": {
						"$ref": "#/components/schemas/users"
					},
					"userid": {
						"type": "string"
					}
				},
				"required": ["id", "userid", "user", "targetid", "target"],
				"type": "object"
			},
			"partnerLinks": {
				"additionalProperties": false,
				"properties": {
					"emoji": {
						"type": "string"
					},
					"id": {
						"type": "string"
					},
					"link": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"partner": {
						"$ref": "#/components/schemas/partners"
					},
					"partnerName": {
						"type": "string"
					}
				},
				"required": [
					"id",
					"partnerName",
					"partner",
					"name",
					"emoji",
					"link"
				],
				"type": "object"
			},
			"partners": {
				"additionalProperties": false,
				"properties": {
					"category": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"id": {
						"type": "string"
					},
					"links": {
						"items": {
							"$ref": "#/components/schemas/partnerLinks"
						},
						"type": "array"
					},
					"logo": {
						"type": "string"
					},
					"long_description": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"owner": {
						"type": "string"
					},
					"ownerImage": {
						"type": "string"
					},
					"ownerLink": {
						"type": "string"
					}
				},
				"required": [
					"id",
					"name",
					"logo",
					"category",
					"owner",
					"ownerImage",
					"description",
					"long_description",
					"links"
				],
				"type": "object"
			},
			"platform": {
				"enum": [
					"DISCORD",
					"TWITTER",
					"INSTAGRAM",
					"TIKTOK",
					"YOUTUBE",
					"GITHUB",
					"WEBSITE"
				],
				"type": "string"
			},
			"plugins": {
				"additionalProperties": false,
				"properties": {
					"href": {
						"type": "string"
					},
					"id": {
						"type": "number"
					},
					"jsonData": {},
					"post": {
						"$ref": "#/components/schemas/posts"
					},
					"postid": {
						"type": "string"
					},
					"type": {
						"type": "string"
					}
				},
				"required": ["id", "postid", "post", "type"],
				"type": "object"
			},
			"posts": {
				"additionalProperties": false,
				"properties": {
					"caption": {
						"type": "string"
					},
					"comments": {
						"items": {
							"$ref": "#/components/schemas/comments"
						},
						"type": "array"
					},
					"createdat": {
						"format": "date-time",
						"type": "string"
					},
					"downvotes": {
						"items": {
							"$ref": "#/components/schemas/downvotes"
						},
						"type": "array"
					},
					"image": {
						"type": "string"
					},
					"plugins": {
						"items": {
							"$ref": "#/components/schemas/plugins"
						},
						"type": "array"
					},
					"postid": {
						"type": "string"
					},
					"type": {
						"type": "number"
					},
					"upvotes": {
						"items": {
							"$ref": "#/components/schemas/upvotes"
						},
						"type": "array"
					},
					"user": {
						"$ref": "#/components/schemas/users"
					},
					"userid": {
						"type": "string"
					}
				},
				"required": [
					"userid",
					"user",
					"caption",
					"plugins",
					"type",
					"postid",
					"upvotes",
					"downvotes",
					"comments",
					"createdat"
				],
				"type": "object"
			},
			"social": {
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string"
					},
					"link": {
						"type": "string"
					},
					"platform": {
						"$ref": "#/components/schemas/platform"
					},
					"user": {
						"$ref": "#/components/schemas/users"
					},
					"userid": {
						"type": "string"
					}
				},
				"required": ["id", "userid", "user", "platform", "link"],
				"type": "object"
			},
			"upvotes": {
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string"
					},
					"post": {
						"$ref": "#/components/schemas/posts"
					},
					"postid": {
						"type": "string"
					},
					"userid": {
						"type": "string"
					}
				},
				"required": ["id", "userid", "postid", "post"],
				"type": "object"
			},
			"users": {
				"additionalProperties": false,
				"properties": {
					"applications": {
						"items": {
							"$ref": "#/components/schemas/applications"
						},
						"type": "array"
					},
					"avatar": {
						"type": "string"
					},
					"badges": {
						"items": {
							"$ref": "#/components/schemas/badge"
						},
						"type": "array"
					},
					"banner": {
						"type": "string"
					},
					"bio": {
						"type": "string"
					},
					"birthDay": {
						"format": "date-time",
						"type": "string"
					},
					"comments": {
						"items": {
							"$ref": "#/components/schemas/comments"
						},
						"type": "array"
					},
					"discord_id": {
						"type": "string"
					},
					"followers": {
						"items": {
							"$ref": "#/components/schemas/following"
						},
						"type": "array"
					},
					"following": {
						"items": {
							"$ref": "#/components/schemas/following"
						},
						"type": "array"
					},
					"name": {
						"type": "string"
					},
					"posts": {
						"items": {
							"$ref": "#/components/schemas/posts"
						},
						"type": "array"
					},
					"pronouns": {
						"type": "string"
					},
					"socials": {
						"items": {
							"$ref": "#/components/schemas/social"
						},
						"type": "array"
					},
					"specialInterests": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"staff_perms": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"state": {
						"$ref": "#/components/schemas/State"
					},
					"userid": {
						"type": "string"
					},
					"usertag": {
						"type": "string"
					}
				},
				"required": [
					"usertag",
					"userid",
					"bio",
					"avatar",
					"banner",
					"socials",
					"followers",
					"following",
					"badges",
					"specialInterests",
					"state",
					"staff_perms",
					"applications",
					"posts",
					"comments"
				],
				"type": "object"
			}
		}
	}
}
